TOKEN = TOKEN_HERE
brand_name='MidVox'
NEXT_PUBLIC_BRAND_NAME='MidVox'

# ── Owner / Staff IDs (comma-separated Discord user IDs) ──────────────────────
# Edit this list — no code changes needed anywhere else
OWNER_IDS=870179991462236170,767979794411028491,1432771000629596225,1382744437049790495,1263404140965396555

# ── Dashboard API ──────────────────────────────────────────────────────────────────
# Set to true to enable the dashboard API server
API_ENABLED="true"
# Port the API server listens on (internal, proxied by Next.js)
API_PORT="5001"
DASHBOARD_API_KEY="MIDVOX_SECURE_API_KEY_12345_CHANGE_THIS_ASAP_BY_CODEX_DEVS"
# Extra CORS-allowed origins, comma-separated (optional)
CORS_ORIGINS=""

#  CODEX DEVS

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_URL="https://discord.com/api/webhooks/"
CMD_WEBHOOK_URL="https://discord.com/api/webhooks/"


# ── Cloudflare Tunnel For API Server ─────────────────────────────────────────────────────────
#
# How to get CF_TUNNEL_TOKEN (browser only, no CLI):
#   1. Go to https://one.dash.cloudflare.com
#   2. Networks → Tunnels → Create a tunnel → Choose "Cloudflared"
#   3. Give it a name (e.g. midvox-api) and save
#   4. On the "Install connector" step, copy the token from the shown command:
#         cloudflared tunnel run --token <COPY_THIS_TOKEN>
#   5. Go to "Published Application Routes" tab → Add a Published Application Routes:
#         Subdomain: midvox-api   Domain: yourdomain.com   Service: http://localhost:8000
#   6. Paste the token below — that's it. Permanent URL, unlimited traffic.
#
TUNNEL_ENABLED="true"
CF_TUNNEL_TOKEN="xxx_xxxx"
CF_TUNNEL_URL="https://midvox-api.yourdomain.com"

# ── MongoDB ─────────────────────────────────────────────────────────────
# Optional: set this to persist config data (AntiSpamPlus, etc.) across
# deploys. If unset, the bot falls back to local SQLite files.
# Required for persistent per-guild settings across Railway redeploys.
# Reuse the same URI when moving the bot to another hosting account.
MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/midvox?retryWrites=true&w=majority

# ── YouTube Shorts & Instagram Reels downloads (Media Downloader) ───────
# The bundled local Cobalt sidecar is tried first, then optional hosted Cobalt
# providers, Instagram's own API when a session is saved, yt-dlp with the
# sessions below, and finally Instagram's public embed page. No cookie is
# required for public posts, but a session significantly improves success from
# datacenter IPs.
COBALT_PUBLIC_URL=""
# Only needed when COBALT_API_URL points at an authenticated Cobalt instance.
COBALT_API_KEY=
# Optional WARP egress for Cobalt (WARP=1 is also accepted by start.sh).
COBALT_WARP=0
# JSON array of up to 3 hosted Cobalt endpoints:
# [{"url":"https://cobalt.example.com","api_key":"..."}]
COBALT_HOSTED_PROVIDERS=[]

# Cookie values accept a raw Cookie header, a Cookie-Editor JSON export, a
# base64 Netscape export, or a path to a cookies.txt file. Never commit real
# sessions; set these in Railway Variables instead.
YT_COOKIES=
# Used by the local Cobalt sidecar, Instagram's API, yt-dlp, and the embed
# fallback. The dashboard's Instagram login saves here too.
INSTAGRAM_COOKIES=
# Sources larger than Discord's upload budget are compressed. This hard cap
# (bytes) stops a runaway download before compression.
MEDIA_SOURCE_MAX_BYTES=104857600
# Optional Instagram login for the yt-dlp fallback.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Path to a Netscape Instagram cookies.txt when not using INSTAGRAM_COOKIES.
INSTAGRAM_COOKIE_FILE=
